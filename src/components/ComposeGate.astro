---
import Composer from "./Composer";
import Icon from "./Icon.astro";
const { parentId, locked = false, unavailable = false } = Astro.props;
const user = Astro.locals.user;
---

{unavailable ? (
  <div class="notice" style="margin:24px">
    This post was deleted. You can still read its replies.
  </div>
) : locked ? (
  <div class="notice" style="margin:24px" data-thread-lock-notice>
    This thread is locked. You can still read the conversation.
  </div>
) : user?.suspended ? (
  <div class="notice" style="margin:24px">
    Your account is suspended. Posting is unavailable.
  </div>
) : !user ? (
  <div class="compose-invite">
    <span class="avatar">
      <Icon name="pen-line" size={18} />
    </span>
    <p>{parentId ? "Have something to add?" : "What are you exploring today?"}</p>
    <a class="button secondary" href="/login">
      Sign in
    </a>
  </div>
) : !user.username ? (
  <div class="compose-invite">
    <p>Choose a username to join the conversation.</p>
    <a class="button" href="/onboarding">
      Set username
    </a>
  </div>
) : !user.emailVerified ? (
  <div class="compose-invite">
    <p>Verify your email before joining in.</p>
    <a class="button secondary" href="/verify">
      Verify email
    </a>
  </div>
) : (
  <Composer client:only="react" parentId={parentId} name={user.name} username={user.username} image={user.image} />
)}
