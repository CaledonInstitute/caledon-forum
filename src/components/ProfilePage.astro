---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Avatar from "./Avatar.astro";
import Badge from "./Badge.astro";
import Post from "./Post.astro";
import Pagination from "./Pagination.astro";
import Icon from "./Icon.astro";
import ComposeGate from "./ComposeGate.astro";
import { profilePosts, profileCounts, type ProfileTab } from "../lib/db";
import { PAGE_SIZE, pageNumber } from "../lib/content";
import type { PublicProfile } from "../lib/types";
import { preparePostContent } from "../lib/post-content";
import { postTime } from "../lib/post-time";
import { profileCardData, profileCardKey } from "../lib/og-card";
import Mark from "./Mark.astro";
interface Props {
  person: PublicProfile | null;
}
const { person } = Astro.props;
const socialImage = person ? new URL((await profileCardKey(profileCardData(person, env.SITE_URL), env.SITE_URL)).url) : undefined;
const requestedTab = Astro.url.searchParams.get("tab");
const tab: ProfileTab = ["replies", "likes", "reposts", "media"].includes(requestedTab || "") ? (requestedTab as ProfileTab) : "posts";
const counts = person ? await profileCounts(person.id) : null;
const page = pageNumber(Astro.url);
const items = person ? await profilePosts(person.id, tab, Astro.locals.user?.id, page) : [];
const prepared = await preparePostContent(items.slice(0, PAGE_SIZE));
const schema = person
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      dateCreated: new Date(person.created_at).toISOString(),
      mainEntity: {
        "@type": "Person",
        "@id": new URL(`/${person.username}`, env.SITE_URL).href,
        name: person.name,
        alternateName: person.username,
        description: person.bio,
        url: new URL(`/${person.username}`, env.SITE_URL).href,
      },
    }
  : undefined;
---

<Layout
  title={person ? `${person.name} (@${person.username})` : "Profile unavailable"}
  description={person?.bio || "Public conversations on Caledon Forum."}
  noindex={!person}
  image={socialImage ? socialImage.pathname + socialImage.search : undefined}
  schema={schema}
  profile
>
  {person ? (
    <div data-own-likes={tab === "likes" && person.id === Astro.locals.user?.id ? "true" : undefined}>
      {person.coverImage && (
        <div class="profile-cover" aria-hidden="true">
          <img
            src={`/api/cover/${encodeURIComponent(person.username)}`}
            alt=""
            width="1200"
            height="400"
            referrerpolicy="no-referrer"
            style="opacity:0"
            onload="this.style.opacity='1'"
            onerror="this.style.opacity='0'"
          />
        </div>
      )}
      <header class="profile-header">
        <div class="profile-heading">
          <Avatar name={person.name} image={person.image} username={person.username} large />
          {person.id === Astro.locals.user?.id && (
            <a class="button secondary" href="/settings">
              Edit profile
            </a>
          )}
          {Astro.locals.user && person.id !== Astro.locals.user.id && (
            <a class="button secondary" href={`/dm?to=${encodeURIComponent(person.username)}`}>
              Message
            </a>
          )}
        </div>
        <h1>
          {person.name}
          {!!person.isCaledonMember && <Badge />}
        </h1>
        <span class="muted small">@{person.username}</span>
        {!!person.isCaledonMember && (
          <p class="profile-membership">
            <Mark small />
            <span>
              Member of <strong>Caledon Institute</strong>
            </span>
          </p>
        )}
        {person.lastActiveAt && (
          <p class="profile-activity muted small" data-presence-for={person.username} title={`${postTime(person.lastActiveAt)} GMT+7`}>
            Last active at {postTime(person.lastActiveAt)}
          </p>
        )}
        {!!person.dmEnabled && <p class="profile-dm muted small">DM enabled</p>}
        {person.bio && <p>{person.bio}</p>}
        {person.location && (
          <p class="profile-location muted small">
            <Icon name="map-pin" size={15} />
            {person.location}
          </p>
        )}
        <p class="muted small">Joined {postTime(person.created_at)}</p>
      </header>
      <nav class="tabs profile-tabs" aria-label="Profile activity" data-profile-user={person.username}>
        {(["posts", "replies", "reposts", "likes", "media"] as const).map((name) => (
          <a href={`/${person.username}${name === "posts" ? "" : `?tab=${name}`}`} class:list={{ active: tab === name }} aria-current={tab === name ? "page" : undefined}>
            {name[0].toUpperCase() + name.slice(1)} <span data-profile-count={name}>{counts?.[name] || 0}</span>
          </a>
        ))}
      </nav>
      {person.id === Astro.locals.user?.id && tab === "posts" && page === 1 && <ComposeGate />}
      <section data-post-list data-own-reposts={tab === "reposts" && person.id === Astro.locals.user?.id ? "true" : undefined} aria-label={tab}>
        {items.length ? (
          items.slice(0, PAGE_SIZE).map((post) => <Post post={post} prepared={prepared.get(post.id)} />)
        ) : (
          <section class="empty" data-post-empty>
            <h2>No {tab} yet.</h2>
            <p>{tab === "likes" ? "Posts and replies liked by this user will appear here." : "Conversations will appear here as they happen."}</p>
          </section>
        )}
      </section>
      <Pagination page={page} hasMore={items.length > PAGE_SIZE} />
    </div>
  ) : (
    <section class="empty">
      <h1>Profile unavailable.</h1>
      <p>Check the username or return to the feed.</p>
      <a class="button secondary" href="/">
        Back to feed
      </a>
    </section>
  )}
</Layout>
