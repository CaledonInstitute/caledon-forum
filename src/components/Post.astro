---
import Avatar from "./Avatar.astro";
import Badge from "./Badge.astro";
import LinkCard from "./LinkCard.astro";
import Icon from "./Icon.astro";
import { preparePostContent, type PostContent } from "../lib/post-content";
import { postTime } from "../lib/post-time";
import type { ForumPost } from "../lib/types";
interface Props {
  post: ForumPost;
  full?: boolean;
  reply?: boolean;
  prepared?: PostContent;
}
const { post: p, full = false, reply = false, prepared } = Astro.props;
const viewer = Astro.locals.user;
const { links, long, body } = prepared || (await preparePostContent([p], new Set(full ? [p.id] : []))).get(p.id)!;
const permalink = `/p/${p.publicId}`;
const createdAt = new Date(p.createdAt);
const time = postTime(p.createdAt);
---

<article
  class:list={["post", { reply, "post-detail": full }]}
  id={`post-${p.id}${p.repostedBy ? `-repost-${p.repostedBy}` : ""}`}
  data-post-id={p.id}
  data-own-repost={p.repostedBy === viewer?.username ? "true" : undefined}
  data-public-id={p.publicId}
  data-updated-at={p.updatedAt}
  data-post-url={!full ? permalink : undefined}
  data-view-post={!full && !p.deleted ? p.id : undefined}
>
  {p.repostedBy && (
    <p class="repost-context">
      <Icon name="repeat-2" size={14} strokeWidth={1.7} />
      <a href={`/${p.repostedBy}`}>{p.repostedName} reposted</a>
    </p>
  )}
  <div class="post-grid">
    <a class="post-avatar-link" href={`/${p.username}`} aria-label={`${p.name}'s profile`}>
      <Avatar name={p.name} image={p.image} username={p.username} />
    </a>
    <div>
      <div class="identity">
        <a href={`/${p.username}`}>
          <strong>{p.name}</strong>
        </a>
        {!!p.isCaledonMember && <Badge />}
        <a class="handle" href={`/${p.username}`}>
          @{p.username}
        </a>
        <a class="post-time" href={permalink}>
          <time datetime={createdAt.toISOString()} title={`${time} GMT+7`}>
            {time}
          </time>
          {p.updatedAt > p.createdAt ? " · Edited" : ""}
        </a>
      </div>
      {p.parentId && (
        <div class="post-context">
          Replying to <a href={`/p/${p.parentPublicId}`}>@{p.parentUsername}</a>
        </div>
      )}
      {p.deleted ? (
        <p class="muted small">This post was deleted.</p>
      ) : (
        <>
          <div class="post-content" data-rich-content data-rich-previews={JSON.stringify(links)} data-rich-long={long ? "true" : undefined}>
            <span class="plain-post">{body}</span>
            <template data-rich-source>{p.body}</template>
          </div>
          <div data-rich-quote></div>
          {long && (
            <a class="read-more" href={permalink}>
              Read more
            </a>
          )}
          {links
            .filter((l) => l.kind !== "image")
            .map((preview) => (
              <LinkCard preview={preview} />
            ))}
          {links
            .filter((l) => l.kind === "image")
            .map((preview) => (
              <a class="external-image-link" href={preview.url} target="_blank" rel="ugc nofollow noopener">
                Open original image
              </a>
            ))}
          <div
            class="post-tools"
            data-post-controls={JSON.stringify({
              id: p.id,
              url: permalink,
              name: p.name,
              directReplies: p.directReplies,
              likes: p.likes,
              liked: !!p.liked,
              shares: p.shares,
              reposts: p.reposts || 0,
              reposted: !!p.reposted,
              views: p.views,
              signedIn: !!viewer,
              owner: viewer?.id === p.authorId,
              admin: viewer?.role === "admin",
              root: !p.rootId,
              locked: !!p.locked,
            })}
          >
            <a href={`${permalink}#reply`}>
              <span data-reply-count={p.id}>{p.directReplies || "Reply"}</span>
            </a>
            <span>
              {p.likes} likes · {p.shares} shares
            </span>
            <span class="post-views" role="img" aria-label={`${p.views} ${p.views === 1 ? "view" : "views"}`}>
              <span aria-hidden="true">{p.views.toLocaleString("en-US")}</span>
            </span>
          </div>
          <p class="error" role="status" data-post-status></p>
        </>
      )}
    </div>
  </div>
</article>
