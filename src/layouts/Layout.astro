---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { env } from "cloudflare:workers";
import Mark from "../components/Mark.astro";
import Avatar from "../components/Avatar.astro";
import { one } from "../lib/db";
import { isValidUsername } from "../lib/usernames";
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: any;
  type?: string;
  profile?: boolean;
}
const {
  title = "Caledon Forum",
  description = "A place to ask, experiment, and learn together. Public conversations on vulnerability research, artificial intelligence, and the things we are building.",
  image = "/api/og/site.png",
  noindex = false,
  schema,
  type = "website",
} = Astro.props;
const viewer = Astro.locals.user;
const origin = new URL(env.SITE_URL).origin;
const canonical = new URL(Astro.url.pathname, origin);
const currentPage = Math.min(100000, Math.max(1, Math.floor(Number(Astro.url.searchParams.get("page"))) || 1));
if (currentPage > 1) canonical.searchParams.set("page", String(currentPage));
if (Astro.props.profile && ["replies", "likes"].includes(Astro.url.searchParams.get("tab") || "")) canonical.searchParams.set("tab", Astro.url.searchParams.get("tab")!);
const path = Astro.url.pathname;
const lastUpdated = __SITE_LAST_UPDATED__;
const lastUpdatedLabel = lastUpdated
  ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" }).format(new Date(lastUpdated))
  : null;
const analyticsAllowed =
  (path === "/" || /^\/p\/[1-9][0-9]{0,18}$/.test(path) || isValidUsername(path.slice(1))) && [...Astro.url.searchParams.keys()].every((key) => key === "page" || key === "tab");
const nav = [
  { label: "Home", href: "/", icon: "home" },
  { label: "DM", href: "/dm", icon: "message-circle" },
  { label: "Search", href: "/search", icon: "search" },
  { label: "Notifications", href: "/notifications", icon: "bell" },
  { label: "Profile", href: viewer?.username ? `/${viewer.username}` : "/login", icon: "user-round" },
] as const;
const dmUnread = viewer
  ? await one<{ n: number }>(
      "SELECT COUNT(*) AS n FROM dm_messages m JOIN dm_conversations c ON c.id=m.conversation_id LEFT JOIN dm_reads r ON r.conversation_id=c.id AND r.user_id=? WHERE (c.user_a=? OR c.user_b=?) AND m.sender_id<>? AND m.seq>COALESCE(r.seq,0)",
      viewer.id,
      viewer.id,
      viewer.id,
      viewer.id
    )
  : null;
const unread = viewer ? await one<{ n: number }>("SELECT COUNT(*) AS n FROM notifications WHERE recipient_id=? AND read_at IS NULL", viewer.id) : null;
const active = (href: string) => (href === "/" ? path === "/" : path === href);
const fullTitle = title === "Caledon Forum" ? title : `${title} | Caledon Forum`;
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${origin}/#organization`,
      name: "Caledon Institute",
      url: "https://caledoninstitute.github.io/",
      sameAs: ["https://github.com/CaledonInstitute"],
    },
    { "@type": "WebSite", "@id": `${origin}/#website`, name: "Caledon Forum", url: origin, publisher: { "@id": `${origin}/#organization` } },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    {analyticsAllowed && env.WEB_ANALYTICS_TOKEN && /^[a-f0-9]{32}$/i.test(env.WEB_ANALYTICS_TOKEN) && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: env.WEB_ANALYTICS_TOKEN })}></script>
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Caledon Forum" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(image, origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Caledon Forum`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, origin).href} />
    <meta name="twitter:image:alt" content={`${title} — Caledon Forum`} />
    {env.SEARCH_CONSOLE_TOKEN && <meta name="google-site-verification" content={env.SEARCH_CONSOLE_TOKEN} />}
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema).replace(/</g, "\\u003c")} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
  </head>
  <body
    data-dm-conversation={path.startsWith("/dm/") ? "true" : undefined}
    data-viewer-id={viewer?.id}
    data-realtime={env.REALTIME_ENABLED === "true" ? "true" : undefined}
    data-presence={env.PRESENCE_ENABLED === "true" ? "true" : undefined}
  >
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="mobile-header" hidden={path.startsWith("/dm/")}>
      <a class="brand" href="/" aria-label="Caledon Forum home">
        <Mark small />
        <span>
          Caledon<span>Forum</span>
        </span>
      </a>
      <div class="mobile-header-actions">
        <a href="/search" aria-label="Search">
          <Icon name="search" size={19} />
        </a>
        <a href="/settings" aria-label="Settings">
          <Icon name="settings" size={19} />
        </a>
      </div>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <a href="/" class="brand" aria-label="Caledon Forum home">
          <Mark />
          <span>
            Caledon<span>Forum</span>
          </span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: active(item.href) }} aria-current={active(item.href) ? "page" : undefined}>
              <Icon name={item.icon} size={21} strokeWidth={1.6} />
              {item.label}
              {item.label === "DM" && !!dmUnread?.n && <span class="dot" data-dm-unread aria-label={`${dmUnread.n} unread messages`} />}
              {item.label === "Notifications" && !!unread?.n && <span class="dot" aria-label={`${unread.n} unread notifications`} />}
            </a>
          ))}
          {viewer?.role === "admin" && (
            <a href="/admin">
              <Icon name="shield" size={21} strokeWidth={1.6} />
              Admin
            </a>
          )}
          <a href="/settings" class:list={{ active: path === "/settings" }}>
            <Icon name="settings" size={21} strokeWidth={1.6} />
            Settings
          </a>
        </nav>
        <div style="margin-top:28px">
          <a class="button" style="width:176px" href={viewer ? "/#compose" : "/login"}>
            <Icon name="pen-line" size={16} />
            Start a thread
          </a>
        </div>
        <div class="sidebar-bottom">
          {viewer ? (
            <a href={viewer.username ? `/${viewer.username}` : "/onboarding"} class="sidebar-user">
              <Avatar name={viewer.name} image={viewer.image} username={viewer.username} />
              <span>
                <strong>{viewer.name}</strong>
                <span class="muted">@{viewer.username || "choose_username"}</span>
              </span>
            </a>
          ) : (
            <a class="text-link small" href="/login">
              Sign in to join in
            </a>
          )}
          <p>A little curiosity is a good place to start.</p>
          <div class="footer-links">
            <a href="/rules">Community rules</a>
            <a href="/privacy">Privacy</a>
            <a href="https://caledoninstitute.github.io/" target="_blank" rel="noopener">
              Institute
            </a>
          </div>
          <p>© {new Date().getUTCFullYear()} Caledon Institute</p>
          {lastUpdated && (
            <p class="site-updated">
              Last updated on <time datetime={lastUpdated}>{lastUpdatedLabel}</time>
            </p>
          )}
        </div>
      </aside>
      <main id="main" class="main" tabindex="-1">
        <slot />
        {lastUpdated && !path.startsWith("/dm/") && (
          <p class="site-updated site-updated-mobile">
            Last updated on <time datetime={lastUpdated}>{lastUpdatedLabel}</time>
          </p>
        )}
      </main>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {nav
        .filter((item) => item.label !== "Search")
        .map((item) => (
          <a href={item.href} class:list={{ active: active(item.href) }} aria-label={item.label} aria-current={active(item.href) ? "page" : undefined}>
            <Icon name={item.icon} size={22} strokeWidth={active(item.href) ? 2 : 1.6} />
            {item.label === "DM" && !!dmUnread?.n && <span class="dot" data-dm-unread aria-label={`${dmUnread.n} unread messages`} />}
            {item.label === "Notifications" && !!unread?.n && <span class="dot" role="img" aria-label={`${unread.n} unread notifications`} />}
          </a>
        ))}
    </nav>
    <script>
      import "../scripts/interactions";
    </script>
  </body>
</html>
