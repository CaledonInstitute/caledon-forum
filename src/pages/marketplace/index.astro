---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Pagination from "../../components/Pagination.astro";
import { listMarketplace, formatPrice } from "../../lib/marketplace";
import { pageNumber } from "../../lib/content";
import { fileUrl } from "../../lib/upload-policy";
const page = pageNumber(Astro.url);
const items = await listMarketplace(Astro.url, page);
---

<Layout title="Marketplace">
  <PageHeader title="Marketplace" subtitle="Goods and services from the community" />
  <div class="marketplace-heading">
    <p>Find something useful. Share what you offer.</p>
    <a class="button" href={Astro.locals.user ? "/marketplace/new" : "/login"}>
      Create listing
    </a>
  </div>
  <form class="marketplace-filters" method="get">
    <input type="search" name="q" aria-label="Search listings" placeholder="Search listings" value={Astro.url.searchParams.get("q")} />
    <select name="kind" aria-label="Listing type">
      <option value="">All types</option>
      <option value="goods" selected={Astro.url.searchParams.get("kind") === "goods"}>
        Goods
      </option>
      <option value="service" selected={Astro.url.searchParams.get("kind") === "service"}>
        Services
      </option>
    </select>
    <select name="status" aria-label="Listing status">
      <option value="active">Available</option>
      <option value="closed" selected={Astro.url.searchParams.get("status") === "closed"}>
        Closed
      </option>
    </select>
    <button class="button secondary">Search</button>
  </form>
  <section class="marketplace-grid" aria-label="Listings">
    {items.slice(0, 20).map((item) => (
      <article class="listing-card">
        <a href={`/marketplace/${item.id}`}>
          <div class="listing-photo">
            {item.photos[0] ? <img src={fileUrl(item.photos[0].id)} alt={item.title} loading="lazy" /> : <span>{item.kind === "service" ? "Service" : "No photo"}</span>}
          </div>
          <div class="listing-copy">
            <p class="listing-price">
              {formatPrice(item.price)}
              {item.negotiable && <small>Negotiable</small>}
            </p>
            <h2>{item.title}</h2>
            <p>{item.location || `Offered by @${item.username}`}</p>
            {item.status === "closed" && <span>Closed</span>}
          </div>
        </a>
      </article>
    ))}
  </section>
  {!items.length && (
    <section class="empty">
      <h2>No listings found.</h2>
      <p>Try another search or offer something to the community.</p>
      <a class="text-link" href="/marketplace/new">
        Create a listing
      </a>
    </section>
  )}
  <Pagination page={page} hasMore={items.length > 20} />
</Layout>
