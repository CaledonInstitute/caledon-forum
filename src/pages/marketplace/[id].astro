---
import Layout from "../../layouts/Layout.astro";
import "../../styles/marketplace.css";
import ListingGallery from "../../components/ListingGallery.astro";
import ListingForm from "../../components/ListingForm";
import { getListing, formatPrice } from "../../lib/marketplace";
const listing = await getListing(Astro.params.id || "");
if (!listing) Astro.response.status = 404;
const owner = listing?.seller_id === Astro.locals.user?.id;
const editing = Astro.url.searchParams.get("edit") === "1";
if (editing && !owner) Astro.response.status = 403;
---

<Layout title={listing?.title || "Listing unavailable"} noindex={editing || !listing}>
  <div class="listing-detail">
    <a href="/marketplace" class="listing-back">
      ‹ Marketplace
    </a>
    {!listing ? (
      <section class="empty">
        <h1>Listing unavailable.</h1>
        <p>It may have been removed.</p>
      </section>
    ) : editing ? (
      owner ? (
        <>
          <h1>Edit listing</h1>
          <ListingForm client:load listing={listing} />
        </>
      ) : (
        <p>You cannot edit this listing.</p>
      )
    ) : (
      <>
        <ListingGallery photos={listing.photos} title={listing.title} />
        <div class="listing-summary">
          {listing.status === "closed" && <span class="listing-status">Closed</span>}
          <h1>{listing.title}</h1>
          <div class="listing-price-row">
            <p class="listing-price">{formatPrice(listing.price)}</p>
            {!!listing.negotiable && <span class="listing-negotiable">Negotiable</span>}
          </div>
          <div class="listing-metadata">
            <p>{listing.kind === "service" ? "Service" : listing.condition === "new" ? "New item" : "Used item"}</p>
            {listing.location && <p>{listing.location}</p>}
          </div>
        </div>
        <section class="listing-description-section" aria-labelledby="listing-description-title">
          <h2 id="listing-description-title">About this listing</h2>
          <p class="listing-description">{listing.description}</p>
        </section>
        <div class="listing-seller">
          <p>
            Offered by{" "}
            <a class="text-link" href={`/${listing.username}`}>
              @{listing.username}
            </a>
          </p>
        </div>
        <div class="listing-actions" data-listing-id={listing.id}>
          {listing.status === "closed" ? (
            <p class="listing-closed-notice">This listing is closed.</p>
          ) : (
            !owner &&
            (listing.dmEnabled ? (
              <a class="button" href={!Astro.locals.user ? "/login" : `/dm?to=${encodeURIComponent(listing.username)}&listing=${listing.id}`}>
                Contact seller
              </a>
            ) : (
              <p class="listing-contact-notice muted">The seller cannot receive DM right now.</p>
            ))
          )}
          {owner && (
            <div class="listing-owner-actions">
              <button
                class:list={["button", { secondary: listing.status === "active" }]}
                data-listing-action="close"
                data-status={listing.status === "active" ? "closed" : "active"}
              >
                {listing.status === "active" ? "Close listing" : "Reopen listing"}
              </button>
              <a class="button secondary" href={`?edit=1`}>
                Edit listing
              </a>
            </div>
          )}
          {Astro.locals.user && (
            <div class="listing-secondary-actions">
              {owner ? (
                <button class="text-button" data-listing-action="delete">
                  Delete listing
                </button>
              ) : (
                <button class="text-button" data-listing-action="report">
                  Report listing
                </button>
              )}
              {Astro.locals.user?.role === "admin" && (
                <button class="text-button" data-listing-action="moderate">
                  Remove as admin
                </button>
              )}
            </div>
          )}
          <p role="status" class="error" data-listing-status></p>
        </div>
      </>
    )}
  </div>
</Layout>
