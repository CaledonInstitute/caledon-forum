---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Post from "../../components/Post.astro";
import ComposeGate from "../../components/ComposeGate.astro";
import Pagination from "../../components/Pagination.astro";
import { publicPost, posts, previews, post, recordPostView } from "../../lib/db";
import { PAGE_SIZE, pageNumber, threadTitle, excerpt } from "../../lib/content";
import { preparePostContent } from "../../lib/post-content";
import { normalizePreviews } from "../../lib/previews";
const p = await publicPost(Astro.params.id!, Astro.locals.user?.id);
const root = p?.rootId ? await post(p.rootId, Astro.locals.user?.id) : p;
if (p && Astro.params.id !== String(p.publicId)) return Astro.redirect(`/p/${p.publicId}${Astro.url.search}`, 301);
const missing = !p || (!!p.deleted && !p.hasChildren);
if (missing) Astro.response.status = p ? 410 : 404;
Astro.response.headers.set("Cache-Control", "private, no-store");
if (!missing) await recordPostView(p!, Astro.request.method);
const page = pageNumber(Astro.url);
const replies = p ? await posts("p.parent_id=?", [p.id], Astro.locals.user?.id, "p.created_at ASC,p.id ASC", page) : [];
const links = p && !p.deleted ? normalizePreviews(await previews(p.id)) : [];
const prepared = await preparePostContent(p ? [p, ...replies.slice(0, PAGE_SIZE)] : [], new Set(p ? [p.id] : []));
const title = missing ? "Thread unavailable" : p!.deleted ? "Conversation" : threadTitle(p!.body, links.find((l) => l.kind !== "image")?.title, p!.name);
const origin = env.SITE_URL;
const schema = !missing
  ? {
      "@context": "https://schema.org",
      "@type": "DiscussionForumPosting",
      "@id": new URL(`/p/${p!.publicId}`, origin).href,
      headline: title,
      text: p!.deleted ? "This post was deleted." : p!.body,
      datePublished: new Date(p!.createdAt).toISOString(),
      dateModified: new Date(p!.updatedAt).toISOString(),
      author: { "@type": "Person", name: p!.name, url: new URL(`/${p!.username}`, origin).href },
      url: new URL(`/p/${p!.publicId}`, origin).href,
      interactionStatistic: [
        { "@type": "InteractionCounter", interactionType: "https://schema.org/LikeAction", userInteractionCount: p!.likes },
        { "@type": "InteractionCounter", interactionType: "https://schema.org/CommentAction", userInteractionCount: p!.directReplies },
      ],
      comment: replies
        .slice(0, PAGE_SIZE)
        .filter((r) => !r.deleted)
        .map((r) => ({
          "@type": "Comment",
          text: r.body,
          datePublished: new Date(r.createdAt).toISOString(),
          dateModified: new Date(r.updatedAt).toISOString(),
          author: { "@type": "Person", name: r.name, url: new URL(`/${r.username}`, origin).href },
          url: new URL(`/p/${r.publicId}`, origin).href,
        })),
    }
  : undefined;
---

<Layout
  title={title}
  description={missing ? "This thread is no longer available." : excerpt(p!.body) || "A conversation on Caledon Forum."}
  noindex={missing}
  type="article"
  image={missing ? undefined : `/api/og/${p!.publicId}.png?v=${p!.updatedAt}`}
  schema={schema}
>
  <PageHeader title={p?.rootId ? "Reply" : "Thread"} replyFor={p?.id} subtitle={missing ? "" : `${p!.directReplies} ${p!.directReplies === 1 ? "reply" : "replies"}`}>
    <a class="text-button" href={p?.parentPublicId ? `/p/${p.parentPublicId}` : "/"}>
      {p?.parentId ? "Back to parent" : "Back to feed"}
    </a>
  </PageHeader>
  {missing ? (
    <section class="empty">
      <h2>This thread is unavailable.</h2>
      <p>It may have been deleted, or the link may be incorrect.</p>
      <a class="button secondary" href="/">
        Explore the feed
      </a>
    </section>
  ) : (
    <>
      <section class="conversation" aria-label="Conversation">
        <Post post={p!} full prepared={prepared.get(p!.id)} />
      </section>
      <ComposeGate parentId={p!.id} locked={!!root?.locked} unavailable={!!p!.deleted} />
      <section class="reply-list" aria-label="Replies" data-parent-id={p!.id}>
        {replies.slice(0, PAGE_SIZE).map((post) => (
          <Post post={post} reply prepared={prepared.get(post.id)} />
        ))}
      </section>
      <Pagination page={page} hasMore={replies.length > PAGE_SIZE} />
    </>
  )}
</Layout>
