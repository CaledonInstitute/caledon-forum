    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.4.4",
    "better-auth": "^1.7.14",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "harfbuzzjs": "0.10.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
